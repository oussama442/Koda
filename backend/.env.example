# Copy this file to .env and set the database you intend to use.
# DB_NAME has no fallback; leave it blank until a target is deliberately chosen.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=

# Application configuration. Replace the placeholder locally before starting.
PORT=5000
JWT_SECRET=replace-with-a-long-random-local-secret
